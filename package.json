{
  "name": "clueso-local-skeleton",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "format": "prettier --write .github .prettierrc.json apps docs infra packages tests \"*.{json,md,mjs,ts}\"",
    "format:check": "prettier --check .github .prettierrc.json apps docs infra packages tests \"*.{json,md,mjs,ts}\"",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace apps/web && tsc --project tsconfig.tools.json",
    "test": "npm run test --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
